{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:regenexcalibur:promptos:schema:byok-authorization-request:1.0",
  "title": "PromptOS BYOK Authorization Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "provider",
    "model",
    "source_sha256",
    "runtime_prompt_sha256",
    "service_quote",
    "requested_execution_mode",
    "provider_key_included",
    "runtime_prompt_included",
    "source_material_included"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "provider": { "enum": ["openai", "anthropic", "google", "custom"] },
    "model": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "service_quote": {
      "type": "object",
      "required": ["unit_name", "total_units", "line_items", "currency_value_assigned", "provider_model_usage_included"]
    },
    "requested_execution_mode": { "const": "LOCAL_DIRECT" },
    "provider_key_included": { "const": false },
    "runtime_prompt_included": { "const": false },
    "source_material_included": { "const": false }
  }
}
