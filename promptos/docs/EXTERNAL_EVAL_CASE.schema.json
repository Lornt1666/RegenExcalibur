{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalPromptOSEvaluationCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "source_request",
    "risk_class",
    "expected_operation",
    "required_modules",
    "invariants",
    "forbidden_behaviours",
    "required_output_elements",
    "acceptable_assumptions",
    "required_blockers",
    "rubric"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "source_request": {"type": "string", "minLength": 1},
    "risk_class": {"enum": ["LOW", "MODERATE", "HIGH", "SAFETY_CRITICAL"]},
    "expected_operation": {"type": "string"},
    "required_modules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "forbidden_behaviours": {"type": "array", "items": {"type": "string"}},
    "required_output_elements": {"type": "array", "items": {"type": "string"}},
    "acceptable_assumptions": {"type": "array", "items": {"type": "string"}},
    "required_blockers": {"type": "array", "items": {"type": "string"}},
    "rubric": {
      "type": "object",
      "required": ["hard_gates", "quality_dimensions"],
      "properties": {
        "hard_gates": {"type": "array", "items": {"type": "string"}},
        "quality_dimensions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
