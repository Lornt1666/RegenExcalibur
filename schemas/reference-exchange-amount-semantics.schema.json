{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/reference-exchange-amount-semantics.schema.json",
  "title": "ProofGrid Reference Exchange Amount Semantics v1.3.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "verdict",
    "parent",
    "amount_semantics",
    "basis_selection_permitted",
    "building_quantity_multiplication_permitted",
    "calculated",
    "environmental_values_transformed",
    "unit_conversion_performed",
    "scientific_validation_performed",
    "professional_review_performed",
    "certified",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ProofGridReferenceExchangeAmountSemantics"},
    "verdict": {"const": "REFERENCE_EXCHANGE_AMOUNT_SEMANTICS_RESOLVED_VERIFIABLE"},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rxep_verdict",
        "rxep_protocol_version",
        "rxep_bundle_content_sha256",
        "rxep_binding_receipt_sha256",
        "source_sha256",
        "process_xml_sha256",
        "process_dataset_uuid",
        "format_version"
      ],
      "properties": {
        "rxep_verdict": {"const": "RXEP_DECLARED_INDICATOR_EVIDENCE_BOUND_VERIFIABLE"},
        "rxep_protocol_version": {"const": "0.2"},
        "rxep_bundle_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rxep_binding_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "process_xml_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "process_dataset_uuid": {"type": "string", "minLength": 1},
        "format_version": {"enum": ["1.2", "1.3"]}
      }
    },
    "amount_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "reference_exchange_internal_id",
        "mean_amount",
        "resulting_amount_present",
        "resulting_amount",
        "selection_policy"
      ],
      "properties": {
        "format_version": {"enum": ["1.2", "1.3"]},
        "reference_exchange_internal_id": {"type": "string", "minLength": 1},
        "mean_amount": {"$ref": "#/$defs/decimalEvidence"},
        "resulting_amount_present": {"const": false},
        "resulting_amount": {"type": "null"},
        "selection_policy": {"const": "MEAN_AMOUNT_ACCEPTED_ONLY_WHEN_RESULTING_AMOUNT_ABSENT"}
      }
    },
    "basis_selection_permitted": {"const": true},
    "building_quantity_multiplication_permitted": {"const": false},
    "calculated": {"const": false},
    "environmental_values_transformed": {"const": false},
    "unit_conversion_performed": {"const": false},
    "scientific_validation_performed": {"const": false},
    "professional_review_performed": {"const": false},
    "certified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization", "signature"],
      "properties": {
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},
        "signature": {"type": "null"}
      }
    }
  },
  "$defs": {
    "decimalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexical", "decimal"],
      "properties": {
        "lexical": {"type": "string", "minLength": 1},
        "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      }
    }
  }
}
