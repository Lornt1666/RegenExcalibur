{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/three-member-partial-set-total-v29.schema.json",
  "title": "ProofGrid v2.9 exact-Decimal three-member PARTIAL total",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","verdict","source_set","compatibility","completeness_status","members","member_count","aggregation","aggregation_performed","sum_performed","whole_building_lca_claimed","declared_scope_complete_claimed","missing_contributions_are_zero","missing_modules_are_zero","unit_conversion_performed","scenario_inference_performed","duplicate_members_permitted","scientific_validation_performed","professional_review_performed","certified","limitations","integrity"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "record_type": {"const":"ProofGridThreeMemberPartialSetExactDecimalTotal"},
    "verdict": {"const":"THREE_MEMBER_PARTIAL_SET_EXACT_DECIMAL_TOTAL_VERIFIABLE"},
    "source_set": {"type":"object"},
    "compatibility": {"type":"object"},
    "completeness_status": {"const":"PARTIAL"},
    "members": {"type":"array","minItems":3,"maxItems":3,"items":{"type":"object"}},
    "member_count": {"const":3},
    "aggregation": {
      "type":"object","additionalProperties":false,
      "required":["method","version","scope","member_order","total_value_decimal","unit"],
      "properties": {
        "method":{"const":"canonical_decimal_sum"},
        "version":{"const":"2.9.0"},
        "scope":{"const":"ADMITTED_SET_MEMBERS_ONLY"},
        "member_order":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/sha"}},
        "total_value_decimal":{"const":"27229.08943503647325"},
        "unit":{"const":"kg CO2 eqv."}
      }
    },
    "aggregation_performed":{"const":true},
    "sum_performed":{"const":true},
    "whole_building_lca_claimed":{"const":false},
    "declared_scope_complete_claimed":{"const":false},
    "missing_contributions_are_zero":{"const":false},
    "missing_modules_are_zero":{"const":false},
    "unit_conversion_performed":{"const":false},
    "scenario_inference_performed":{"const":false},
    "duplicate_members_permitted":{"const":false},
    "scientific_validation_performed":{"const":false},
    "professional_review_performed":{"const":false},
    "certified":{"const":false},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "integrity": {"type":"object","additionalProperties":false,"required":["content_sha256","canonicalization","signature"],"properties":{"content_sha256":{"$ref":"#/$defs/sha"},"canonicalization":{"const":"UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},"signature":{"type":"null"}}}
  },
  "$defs": {
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
