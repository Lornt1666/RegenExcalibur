{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/declaration-product-identity-closure.schema.json",
  "title": "ProofGrid Declaration Product Identity Closure v1.4.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "verdict",
    "source_identity",
    "parent_evidence",
    "process_reference",
    "product_flow",
    "flow_property",
    "reference_unit",
    "declared_reference_basis",
    "environmental_evidence_binding",
    "calculated",
    "environmental_values_transformed",
    "building_quantity_multiplication_performed",
    "aggregation_performed",
    "unit_conversion_performed",
    "scientific_validation_performed",
    "professional_review_performed",
    "certified",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ProofGridDeclarationProductIdentityClosure"},
    "verdict": {"const": "DECLARATION_PRODUCT_IDENTITY_CLOSURE_BOUND_VERIFIABLE"},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "process_xml_sha256", "process_dataset_uuid", "format_version", "canonical_source_content_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha"},
        "process_xml_sha256": {"$ref": "#/$defs/sha"},
        "process_dataset_uuid": {"type": "string", "minLength": 1},
        "format_version": {"enum": ["1.2", "1.3"]},
        "canonical_source_content_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "parent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v14_bundle_content_sha256",
        "v14_bundle_file_sha256",
        "v14_bundle_receipt_sha256",
        "v13_basis_content_sha256",
        "v13_basis_file_sha256",
        "v13_basis_receipt_sha256"
      ],
      "properties": {
        "v14_bundle_content_sha256": {"$ref": "#/$defs/sha"},
        "v14_bundle_file_sha256": {"$ref": "#/$defs/sha"},
        "v14_bundle_receipt_sha256": {"$ref": "#/$defs/sha"},
        "v13_basis_content_sha256": {"$ref": "#/$defs/sha"},
        "v13_basis_file_sha256": {"$ref": "#/$defs/sha"},
        "v13_basis_receipt_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "process_reference": {"$ref": "#/$defs/processReference"},
    "product_flow": {"$ref": "#/$defs/productFlow"},
    "flow_property": {"$ref": "#/$defs/flowProperty"},
    "reference_unit": {"$ref": "#/$defs/referenceUnit"},
    "declared_reference_basis": {"$ref": "#/$defs/declaredBasis"},
    "environmental_evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "indicator_scope", "environmental_result_unit", "product_reference_unit", "unit_interchange_permitted"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 1},
        "indicator_scope": {"type": "object", "minProperties": 1},
        "environmental_result_unit": {"type": "string", "minLength": 1},
        "product_reference_unit": {"type": "string", "minLength": 1},
        "unit_interchange_permitted": {"const": false}
      }
    },
    "calculated": {"const": false},
    "environmental_values_transformed": {"const": false},
    "building_quantity_multiplication_performed": {"const": false},
    "aggregation_performed": {"const": false},
    "unit_conversion_performed": {"const": false},
    "scientific_validation_performed": {"const": false},
    "professional_review_performed": {"const": false},
    "certified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization", "signature"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},
        "signature": {"type": "null"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decimalEvidence": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "nameEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "value"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "processReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exchange_amount_decimal", "exchange_amount_lexical", "product_flow_uuid", "product_flow_version", "quantitative_reference_type", "reference_exchange_internal_id"],
      "properties": {
        "exchange_amount_decimal": {"$ref": "#/$defs/decimalEvidence"},
        "exchange_amount_lexical": {"type": "string", "minLength": 1},
        "product_flow_uuid": {"type": "string", "minLength": 1},
        "product_flow_version": {"type": "string", "minLength": 1},
        "quantitative_reference_type": {"type": "string", "minLength": 1},
        "reference_exchange_internal_id": {"type": "string", "minLength": 1}
      }
    },
    "productFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "reference_flow_property_internal_id", "sha256", "uuid", "version"],
      "properties": {
        "names": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nameEntry"}},
        "reference_flow_property_internal_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "uuid": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "flowProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_mean_decimal", "flow_mean_lexical", "master_sha256", "names", "reference_unit_group_uuid", "uuid", "version"],
      "properties": {
        "flow_mean_decimal": {"$ref": "#/$defs/decimalEvidence"},
        "flow_mean_lexical": {"type": "string", "minLength": 1},
        "master_sha256": {"$ref": "#/$defs/sha"},
        "names": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nameEntry"}},
        "reference_unit_group_uuid": {"type": "string", "minLength": 1},
        "uuid": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "referenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_decimal", "factor_lexical", "name", "reference_unit_internal_id", "unit_group_master_sha256", "unit_group_uuid", "unit_group_version"],
      "properties": {
        "factor_decimal": {"$ref": "#/$defs/decimalEvidence"},
        "factor_lexical": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "reference_unit_internal_id": {"type": "string", "minLength": 1},
        "unit_group_master_sha256": {"$ref": "#/$defs/sha"},
        "unit_group_uuid": {"type": "string", "minLength": 1},
        "unit_group_version": {"type": "string", "minLength": 1}
      }
    },
    "declaredBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_status", "identity_chain", "product_flow_uuid", "quantity_decimal", "statement", "unit"],
      "properties": {
        "basis_status": {"const": "IDENTITY_CHAIN_VERIFIED"},
        "identity_chain": {"const": true},
        "product_flow_uuid": {"type": "string", "minLength": 1},
        "quantity_decimal": {"$ref": "#/$defs/decimalEvidence"},
        "statement": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    }
  }
}
