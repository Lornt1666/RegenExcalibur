{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/declared-reference-basis.schema.json",
  "title": "ProofGrid Declared Reference Basis v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "verdict",
    "calculated",
    "environmental_values_transformed",
    "unit_conversion_performed",
    "scientific_validation_performed",
    "professional_review_performed",
    "certified",
    "parent",
    "process_reference",
    "product_flow",
    "flow_property",
    "reference_unit",
    "declared_reference_basis",
    "reference_closure",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ProofGridDeclaredReferenceBasis"},
    "verdict": {"const": "DECLARED_REFERENCE_BASIS_EXTRACTED_VERIFIABLE"},
    "calculated": {"const": false},
    "environmental_values_transformed": {"const": false},
    "unit_conversion_performed": {"const": false},
    "scientific_validation_performed": {"const": false},
    "professional_review_performed": {"const": false},
    "certified": {"const": false},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rxep_verdict", "rxep_protocol_version", "rxep_bundle_content_sha256", "rxep_bundle_file_sha256", "rxep_binding_receipt_sha256", "source_sha256", "process_xml_sha256", "process_dataset_uuid", "format_version"],
      "properties": {
        "rxep_verdict": {"const": "RXEP_DECLARED_INDICATOR_EVIDENCE_BOUND_VERIFIABLE"},
        "rxep_protocol_version": {"const": "0.2"},
        "rxep_bundle_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rxep_bundle_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rxep_binding_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "process_xml_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "process_dataset_uuid": {"type": "string", "minLength": 1},
        "format_version": {"enum": ["1.2", "1.3"]}
      }
    },
    "process_reference": {"type": "object", "additionalProperties": true},
    "product_flow": {"type": "object", "additionalProperties": true},
    "flow_property": {"type": "object", "additionalProperties": true},
    "reference_unit": {"type": "object", "additionalProperties": true},
    "declared_reference_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_status", "quantity_decimal", "unit", "product_flow_uuid", "identity_chain", "statement"],
      "properties": {
        "basis_status": {"const": "IDENTITY_CHAIN_VERIFIED"},
        "quantity_decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "unit": {"type": "string", "minLength": 1},
        "product_flow_uuid": {"type": "string", "minLength": 1},
        "identity_chain": {"const": true},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "reference_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_receipt_sha256", "resolution_policy", "files"],
      "properties": {
        "research_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "resolution_policy": {"const": "EXPLICIT_PINNED_REFERENCE_CLOSURE_ONLY_NO_NETWORK_OR_FUZZY_LOOKUP"},
        "files": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["role", "sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization", "signature"],
      "properties": {
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},
        "signature": {"type": "null"}
      }
    }
  }
}
