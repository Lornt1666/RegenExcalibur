{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/environmental-source-identity.schema.json",
  "title": "ProofGrid v1.0 admitted environmental source identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "id",
    "verdict",
    "certified",
    "impact_values_normalized",
    "scientific_validation_performed",
    "professional_review_performed",
    "source",
    "identity",
    "authority",
    "routing",
    "conformance",
    "admission",
    "rxep_bridge",
    "evidence_dimensions",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ProofGridCanonicalEnvironmentalSourceIdentity"},
    "id": {"type": "string", "minLength": 1},
    "verdict": {"const": "ADMITTED_ENVIRONMENTAL_SOURCE_IDENTITY_VERIFIABLE"},
    "certified": {"const": false},
    "impact_values_normalized": {"const": false},
    "scientific_validation_performed": {"const": false},
    "professional_review_performed": {"const": false},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "package_manifest_sha256", "container", "media_type", "format_name", "format_version"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "package_manifest_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        },
        "container": {"enum": ["ZIP", "XML"]},
        "media_type": {"type": "string", "minLength": 1},
        "format_name": {"const": "ILCD+EPD"},
        "format_version": {"enum": ["1.2", "1.3"]}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_dataset_uuid", "process_xml_sha256", "dataset_version", "names", "registration_number"],
      "properties": {
        "process_dataset_uuid": {"type": "string", "minLength": 1},
        "process_xml_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dataset_version": {"type": ["string", "null"]},
        "names": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "value"],
            "properties": {
              "language": {"type": ["string", "null"]},
              "value": {"type": "string", "minLength": 1}
            }
          }
        },
        "registration_number": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "status", "transformation", "redistribution"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "transformation": {"const": "ALLOWED"},
        "redistribution": {"enum": ["ALLOWED", "PROHIBITED", "UNKNOWN"]}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["route"],
      "properties": {
        "route": {"enum": ["OEKOBAUDAT_V12_PROFILE_3_8_0", "INDATA_V13_XSD_MASTERDATA_ONLY"]}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["receipt_sha256", "profile_validation_performed"],
      "properties": {
        "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_validation_performed": {"type": "boolean"}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "preflight_receipt_sha256"],
      "properties": {
        "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "preflight_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "rxep_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supporting_evidence_only", "review_state_elevation_permitted"],
      "properties": {
        "supporting_evidence_only": {"const": true},
        "review_state_elevation_permitted": {"const": false}
      }
    },
    "evidence_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authority", "source_integrity", "format_or_profile_conformance", "identity_normalization", "impact_values", "scientific_validity", "professional_review", "certification"],
      "properties": {
        "source_authority": {"const": "BOUND_FROM_ADMISSION"},
        "source_integrity": {"const": "REVERIFIED"},
        "format_or_profile_conformance": {"const": "BOUND_FROM_ADMISSION"},
        "identity_normalization": {"const": "DETERMINISTIC_METADATA_ONLY"},
        "impact_values": {"const": "NOT_NORMALIZED"},
        "scientific_validity": {"const": "NOT_EVALUATED"},
        "professional_review": {"const": "NOT_EVALUATED"},
        "certification": {"const": "NOT_EVALUATED"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization"],
      "properties": {
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"}
      }
    }
  }
}
