{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/model-inventory-basis-v30.schema.json",
  "title": "ProofGrid v3.0 model inventory basis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "verdict", "source", "inventory_policy_sha256",
    "authorization_manifest_sha256", "inventory_summary", "entries", "identity_set_sha256",
    "zero_silent_drops", "synthetic_input", "acceptance_eligible", "whole_building_lca_claimed",
    "scientific_validation_performed", "professional_review_performed", "certified",
    "limitations", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "record_type": {"const": "ProofGridModelInventoryBasis"},
    "verdict": {"enum": ["MODEL_INVENTORY_BASIS_TEST_ONLY", "MODEL_INVENTORY_BASIS_CLOSED_FOR_POLICY"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "ifc_schema", "adapter_name", "adapter_version"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "ifc_schema": {"type": "string", "minLength": 1},
        "adapter_name": {"const": "ifcopenshell"},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "inventory_policy_sha256": {"$ref": "#/$defs/sha"},
    "authorization_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "inventory_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enumerated_count", "classified_count", "evidence_required_count", "evidence_not_applicable_count", "out_of_declared_scope_count"],
      "properties": {
        "enumerated_count": {"type": "integer", "minimum": 1},
        "classified_count": {"type": "integer", "minimum": 1},
        "evidence_required_count": {"type": "integer", "minimum": 0},
        "evidence_not_applicable_count": {"type": "integer", "minimum": 0},
        "out_of_declared_scope_count": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "identity_set_sha256": {"$ref": "#/$defs/sha"},
    "zero_silent_drops": {"const": true},
    "synthetic_input": {"type": "boolean"},
    "acceptance_eligible": {"type": "boolean"},
    "whole_building_lca_claimed": {"const": false},
    "scientific_validation_performed": {"const": false},
    "professional_review_performed": {"const": false},
    "certified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "allOf": [
    {
      "if": {"properties": {"synthetic_input": {"const": true}}},
      "then": {
        "properties": {
          "verdict": {"const": "MODEL_INVENTORY_BASIS_TEST_ONLY"},
          "acceptance_eligible": {"const": false},
          "authorization_manifest_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"synthetic_input": {"const": false}}},
      "then": {
        "properties": {
          "verdict": {"const": "MODEL_INVENTORY_BASIS_CLOSED_FOR_POLICY"},
          "acceptance_eligible": {"const": true},
          "authorization_manifest_sha256": {"$ref": "#/$defs/sha"}
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relationship_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_step_id", "relationship_type", "target_step_id", "target_global_id", "target_ifc_type"],
      "properties": {
        "relationship_step_id": {"type": "integer", "minimum": 1},
        "relationship_type": {"type": "string", "minLength": 1},
        "target_step_id": {"type": "integer", "minimum": 1},
        "target_global_id": {"type": ["string", "null"]},
        "target_ifc_type": {"type": "string", "minLength": 1}
      }
    },
    "material_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["association_step_id", "relating_material_step_id", "relating_material_type"],
      "properties": {
        "association_step_id": {"type": "integer", "minimum": 1},
        "relating_material_step_id": {"type": ["integer", "null"], "minimum": 1},
        "relating_material_type": {"type": "string", "minLength": 1}
      }
    },
    "unit": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step_id", "ifc_type", "unit_type", "name", "prefix", "source"],
          "properties": {
            "step_id": {"type": ["integer", "null"], "minimum": 1},
            "ifc_type": {"type": "string", "minLength": 1},
            "unit_type": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]},
            "prefix": {"type": ["string", "null"]},
            "source": {"enum": ["explicit_quantity_unit", "project_unit_context", "unresolved"]}
          }
        }
      ]
    },
    "quantity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_step_id", "set_step_id", "set_name", "quantity_step_id", "quantity_type", "name", "value_lexical", "value_decimal", "parser_numeric_value", "parser_numeric_value_is_authority", "source_token_is_authority", "unit"],
      "properties": {
        "relationship_step_id": {"type": "integer", "minimum": 1},
        "set_step_id": {"type": "integer", "minimum": 1},
        "set_name": {"type": ["string", "null"]},
        "quantity_step_id": {"type": "integer", "minimum": 1},
        "quantity_type": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "value_lexical": {"type": "string", "minLength": 1},
        "value_decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "parser_numeric_value": {"type": "number"},
        "parser_numeric_value_is_authority": {"const": false},
        "source_token_is_authority": {"const": true},
        "unit": {"$ref": "#/$defs/unit"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "step_id", "global_id", "ifc_type", "name", "classification_state", "classification_reason", "containment", "decomposition", "material_associations", "declared_quantities"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha"},
        "step_id": {"type": "integer", "minimum": 1},
        "global_id": {"type": ["string", "null"]},
        "ifc_type": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "classification_state": {"enum": ["EVIDENCE_REQUIRED", "EVIDENCE_NOT_APPLICABLE", "OUT_OF_DECLARED_EVIDENCE_SCOPE"]},
        "classification_reason": {"type": "string", "minLength": 1},
        "containment": {"type": "array", "items": {"$ref": "#/$defs/relationship_ref"}},
        "decomposition": {"type": "array", "items": {"$ref": "#/$defs/relationship_ref"}},
        "material_associations": {"type": "array", "items": {"$ref": "#/$defs/material_ref"}},
        "declared_quantities": {"type": "array", "items": {"$ref": "#/$defs/quantity_ref"}}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization", "signature"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},
        "signature": {"type": "null"}
      }
    }
  }
}
