{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/declaration-evidence-bundle.schema.json",
  "title": "ProofGrid Declaration Evidence Bundle v1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "verdict",
    "source_identity",
    "parent_evidence",
    "environmental_results",
    "declared_reference_basis",
    "amount_semantics",
    "dimension_separation",
    "calculated",
    "environmental_values_transformed",
    "building_quantity_multiplication_performed",
    "aggregation_performed",
    "unit_conversion_performed",
    "scientific_validation_performed",
    "professional_review_performed",
    "certified",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ProofGridDeclarationEvidenceBundle"},
    "verdict": {"const": "DECLARATION_EVIDENCE_DIMENSIONS_BOUND_VERIFIABLE"},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "process_xml_sha256", "process_dataset_uuid", "format_version", "canonical_source_content_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha"},
        "process_xml_sha256": {"$ref": "#/$defs/sha"},
        "process_dataset_uuid": {"type": "string", "minLength": 1},
        "format_version": {"enum": ["1.2", "1.3"]},
        "canonical_source_content_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "parent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_indicators", "declared_reference_basis", "amount_semantics"],
      "properties": {
        "declared_indicators": {"$ref": "#/$defs/recordReceiptBinding"},
        "declared_reference_basis": {"$ref": "#/$defs/recordReceiptBinding"},
        "amount_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_file_sha256", "integration_receipt_sha256", "accepted_parent_v13_head"],
          "properties": {
            "evidence_file_sha256": {"$ref": "#/$defs/sha"},
            "integration_receipt_sha256": {"$ref": "#/$defs/sha"},
            "accepted_parent_v13_head": {"const": "77931d81ae9857eb33b3cecaf8f9180f0c2b7e4a"}
          }
        }
      }
    },
    "environmental_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator_scope", "rows", "row_count", "value_origin", "aggregation_performed", "missing_modules_are_zero"],
      "properties": {
        "indicator_scope": {"type": "object"},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "row_count": {"type": "integer", "minimum": 1},
        "value_origin": {"const": "DECLARED_IN_SOURCE"},
        "aggregation_performed": {"const": false},
        "missing_modules_are_zero": {"const": false}
      }
    },
    "declared_reference_basis": {
      "type": "object",
      "required": ["basis_status", "identity_chain", "product_flow_uuid", "quantity_decimal", "unit", "statement"],
      "properties": {
        "basis_status": {"const": "IDENTITY_CHAIN_VERIFIED"},
        "identity_chain": {"const": true},
        "product_flow_uuid": {"type": "string", "minLength": 1},
        "quantity_decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "unit": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "amount_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "reference_exchange_internal_id", "mean_amount", "resulting_amount_present", "resulting_amount", "selection_policy"],
      "properties": {
        "format_version": {"enum": ["1.2", "1.3"]},
        "reference_exchange_internal_id": {"type": "string", "minLength": 1},
        "mean_amount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lexical", "decimal"],
          "properties": {
            "lexical": {"type": "string", "minLength": 1},
            "decimal": {"type": "string", "minLength": 1}
          }
        },
        "resulting_amount_present": {"const": false},
        "resulting_amount": {"type": "null"},
        "selection_policy": {"const": "MEAN_AMOUNT_ACCEPTED_ONLY_WHEN_RESULTING_AMOUNT_ABSENT"}
      }
    },
    "dimension_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmental_result_unit", "product_reference_unit", "same_dimension", "unit_interchange_permitted"],
      "properties": {
        "environmental_result_unit": {"type": "string", "minLength": 1},
        "product_reference_unit": {"type": "string", "minLength": 1},
        "same_dimension": {"const": false},
        "unit_interchange_permitted": {"const": false}
      }
    },
    "calculated": {"const": false},
    "environmental_values_transformed": {"const": false},
    "building_quantity_multiplication_performed": {"const": false},
    "aggregation_performed": {"const": false},
    "unit_conversion_performed": {"const": false},
    "scientific_validation_performed": {"const": false},
    "professional_review_performed": {"const": false},
    "certified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization", "signature"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},
        "signature": {"type": "null"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recordReceiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_content_sha256", "record_file_sha256", "receipt_sha256"],
      "properties": {
        "record_content_sha256": {"$ref": "#/$defs/sha"},
        "record_file_sha256": {"$ref": "#/$defs/sha"},
        "receipt_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
