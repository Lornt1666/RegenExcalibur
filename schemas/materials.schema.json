{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/materials.schema.json",
  "title": "ProofGrid Material Factor Set v0.2",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "quantity",
      "unit",
      "gwp_kgco2e_per_unit",
      "factor_source"
    ],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "quantity": {"type": "number", "minimum": 0},
      "unit": {"type": "string", "minLength": 1},
      "gwp_kgco2e_per_unit": {"type": "number", "minimum": 0},
      "factor_source": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  }
}
