{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/materials.schema.json",
  "title": "ProofGrid Material Quantity Set v0.3",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "material_identity_id", "name", "quantity", "unit", "source_record_id"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "material_identity_id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "quantity": {"type": "number", "minimum": 0},
      "unit": {"type": "string", "minLength": 1},
      "source_record_id": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  }
}
