{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/declared-scope-coverage-manifest-v22.schema.json",
  "title": "ProofGrid v2.2 Synthetic Declared Scope Coverage Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "synthetic", "real_project", "scope_kind", "required_slots", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"const": "proofgrid-v22-synthetic-three-slot-declared-scope"},
    "synthetic": {"const": true},
    "real_project": {"const": false},
    "scope_kind": {"const": "SYNTHETIC_DECLARED_SCOPE_TEST"},
    "required_slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "kind", "expected_element_global_id", "binding"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["IFC_ELEMENT", "SYNTHETIC_REQUIRED_SLOT"]},
          "expected_element_global_id": {"type": ["string", "null"]},
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "semantic_identity_sha256"],
            "properties": {
              "status": {"enum": ["COVERED", "UNRESOLVED"]},
              "semantic_identity_sha256": {
                "oneOf": [
                  {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  {"type": "null"}
                ]
              }
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "COVERED"}}},
                "then": {"properties": {"semantic_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
              },
              {
                "if": {"properties": {"status": {"const": "UNRESOLVED"}}},
                "then": {"properties": {"semantic_identity_sha256": {"type": "null"}}}
              }
            ]
          }
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
