{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/ifc-declaration-product-mapping.schema.json",
  "title": "ProofGrid v1.5 explicit IFC to declaration product mapping artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_version", "mapping"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_version": {"const": "1.5.0"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_ifc", "element", "material", "quantity", "declaration", "review", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_ifc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "schema"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha"},
            "schema": {"type": "string", "minLength": 1}
          }
        },
        "element": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step_id", "global_id", "ifc_type"],
          "properties": {
            "step_id": {"type": "integer", "minimum": 1},
            "global_id": {"type": "string", "minLength": 1},
            "ifc_type": {"type": "string", "minLength": 1}
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["association_step_id", "material_step_id", "declared_name", "source_type"],
          "properties": {
            "association_step_id": {"type": "integer", "minimum": 1},
            "material_step_id": {"type": "integer", "minimum": 1},
            "declared_name": {"type": "string", "minLength": 1},
            "source_type": {"type": "string", "minLength": 1}
          }
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["set_step_id", "quantity_step_id", "name", "ifc_quantity_type", "value", "unit"],
          "properties": {
            "set_step_id": {"type": "integer", "minimum": 1},
            "quantity_step_id": {"type": "integer", "minimum": 1},
            "name": {"type": "string", "minLength": 1},
            "ifc_quantity_type": {"const": "IfcQuantityWeight"},
            "value": {"type": "number", "exclusiveMinimum": 0},
            "unit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit_type", "name", "prefix", "source"],
              "properties": {
                "unit_type": {"const": "MASSUNIT"},
                "name": {"const": "GRAM"},
                "prefix": {"const": "KILO"},
                "source": {"enum": ["project_unit_context", "explicit_quantity_unit"]}
              }
            }
          }
        },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_content_sha256", "bundle_receipt_sha256", "source_sha256", "process_dataset_uuid", "basis_record_content_sha256", "basis_receipt_sha256", "product_flow_uuid", "product_flow_version", "reference_quantity_decimal", "reference_unit"],
          "properties": {
            "bundle_content_sha256": {"$ref": "#/$defs/sha"},
            "bundle_receipt_sha256": {"$ref": "#/$defs/sha"},
            "source_sha256": {"$ref": "#/$defs/sha"},
            "process_dataset_uuid": {"type": "string", "minLength": 1},
            "basis_record_content_sha256": {"$ref": "#/$defs/sha"},
            "basis_receipt_sha256": {"$ref": "#/$defs/sha"},
            "product_flow_uuid": {"type": "string", "minLength": 1},
            "product_flow_version": {"type": "string", "minLength": 1},
            "reference_quantity_decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            "reference_unit": {"const": "kg"}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reviewer", "role", "rationale", "reference"],
          "properties": {
            "state": {"const": "REVIEWED_MAPPING_DECISION"},
            "reviewer": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "rationale": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
