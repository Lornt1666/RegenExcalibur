{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regenexcalibur.example/schemas/rxep-v02-declared-indicator-bundle.schema.json",
  "title": "ProofGrid RXEP v0.2 Declared Indicator Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "verdict",
    "protocol_version",
    "certified",
    "review_state",
    "signed",
    "parent",
    "envelope_count",
    "envelopes",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ProofGridRXEPDeclaredIndicatorEvidenceBundle"},
    "verdict": {"const": "RXEP_DECLARED_INDICATOR_EVIDENCE_BOUND_VERIFIABLE"},
    "protocol_version": {"const": "0.2"},
    "certified": {"const": false},
    "review_state": {"const": "CLAIMED"},
    "signed": {"const": false},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_1_verdict",
        "extraction_receipt_sha256",
        "record_content_sha256",
        "record_file_sha256",
        "source_sha256",
        "process_xml_sha256",
        "process_dataset_uuid",
        "format_version",
        "canonical_source_content_sha256",
        "admission_receipt_sha256"
      ],
      "properties": {
        "v1_1_verdict": {"const": "DECLARED_ENVIRONMENTAL_INDICATORS_EXTRACTED_VERIFIABLE"},
        "extraction_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "record_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "record_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "process_xml_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "process_dataset_uuid": {"type": "string", "minLength": 1},
        "format_version": {"enum": ["1.2", "1.3"]},
        "canonical_source_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "admission_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "envelope_count": {"type": "integer", "minimum": 1},
    "envelopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://regenexcalibur.example/schemas/rxep/v0.2/evidence-envelope.schema.json"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "canonicalization", "signature"],
      "properties": {
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"},
        "signature": {"type": "null"}
      }
    }
  }
}
